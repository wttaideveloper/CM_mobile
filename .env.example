# Copy to `.env` and adjust per environment.
# App code reads these via `src/config` (API_CONFIG).

EXPO_PUBLIC_API_BASE_URL=https://chat.wisdomtooth.tech
EXPO_PUBLIC_AUTH_BASE_URL=https://admin.apis.invigor8.app
EXPO_PUBLIC_WORKFLOW_BASE_URL=https://workflow.apis.invigor8.app
EXPO_PUBLIC_SOCKET_URL=https://chat.wisdomtooth.tech
EXPO_PUBLIC_OAUTH_FRONTEND_ORIGIN=invigoratehealth://oauth
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_TYPING_GET_ENABLED=false
EXPO_PUBLIC_TYPING_PUT_ENABLED=false
